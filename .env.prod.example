# Copie para .env.prod na VPS e ajuste os valores.
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Plano de atualizacao: docs/ATUALIZACAO_AMBIENTES.md

# Versao das imagens GHCR (deve coincidir com a tag Git, ex.: v1.1.0 -> 1.1.0)
IMAGE_TAG=1.1.0

# URL publica da API (lida pelo browser via /runtime-config na Vercel)
API_URL=https://api.tccsinistros.duckdns.org

# Origem exata do frontend (Vercel ou dominio proprio)
CORS_ORIGINS=https://tcc-pipeline-transito-sus.vercel.app

# Porta local do container web (Nginx faz proxy para 127.0.0.1:WEB_PORT)
WEB_PORT=3000

LOG_LEVEL=INFO

# Endpoints pesados desligados em producao
MCP_BRIDGE_ENABLED=false
PREDICT_ENABLED=false
RATE_LIMIT_RPM=60
