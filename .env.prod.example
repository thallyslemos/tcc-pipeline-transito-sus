# Copie para .env.prod na VPS e ajuste os valores.
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Versao das imagens GHCR (deve coincidir com a tag Git, ex.: v1.0.0 -> 1.0.0)
IMAGE_TAG=1.0.0

# URL publica da API (lida pelo browser via /runtime-config)
API_URL=https://api.seudominio.com

# Origens permitidas pelo CORS da FastAPI (URL do dashboard)
CORS_ORIGINS=https://dashboard.seudominio.com

# Porta exposta do frontend (use 3000 atras de Nginx ou 80 se mapear directo)
WEB_PORT=3000

LOG_LEVEL=INFO
