# ============================================================
# Pipeline Analítico de Acidentes de Trânsito no SUS
# Copie para .env e ajuste os valores conforme necessário.
# ============================================================

# Ambiente: development | staging | production
APP_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# DuckDB
DUCKDB_PATH=data/transito_sus.duckdb

# Diretórios de dados (Medallion)
DATA_DIR=data
BRONZE_DIR=data/bronze
SILVER_DIR=data/silver
GOLD_DIR=data/gold

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Segurança da API
# Em producao: MCP_BRIDGE_ENABLED=false e PREDICT_ENABLED=false (padrao se APP_ENV=production)
MCP_BRIDGE_ENABLED=true
PREDICT_ENABLED=true
RATE_LIMIT_RPM=120

# Frontend
# Em Docker/producao use API_URL (runtime). NEXT_PUBLIC_API_URL so no `next dev` local.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- PostgreSQL (opcional: API/MCP em produção na VPS) ---
# USE_POSTGRES=true exige DATABASE_URL apontando para uma base já migrada e carregada.
USE_POSTGRES=false
# Exemplo: postgresql://usuario:senha@localhost:5432/transito_sus
DATABASE_URL=
POSTGRES_SCHEMA=public

# Malha municipal para GET /api/sim/geo (ficheiro gitignored; monte no container)
# GEOJSON_PATH=data/ibge_malhas_municipios.geojson
