# Nginx — exemplo para VPS (EC2 + DuckDNS)
# Copie para /etc/nginx/sites-available/tccsinistros e ajuste server_name.
# ln -s .../sites-available/tccsinistros .../sites-enabled/
#
# Pre-requisito: docker compose com API em 127.0.0.1:8000 (ver docker-compose.prod.yml)

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=web_limit:10m rate=120r/m;

upstream tcc_api {
    server 127.0.0.1:8000;
    keepalive 8;
}

upstream tcc_web {
    server 127.0.0.1:3000;
    keepalive 8;
}

# Redireciona HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name tccsinistros.duckdns.org api.tccsinistros.duckdns.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# API FastAPI
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.tccsinistros.duckdns.org;

    ssl_certificate     /etc/letsencrypt/live/tccsinistros.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tccsinistros.duckdns.org/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 1m;

    location / {
        limit_req zone=api_limit burst=15 nodelay;
        proxy_pass http://tcc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# Frontend Next.js (opcional se nao usar Vercel)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tccsinistros.duckdns.org;

    ssl_certificate     /etc/letsencrypt/live/tccsinistros.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tccsinistros.duckdns.org/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        limit_req zone=web_limit burst=40 nodelay;
        proxy_pass http://tcc_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
